<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-id-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-id-demo</name>
    <description>示例工程：验证 aifei-id 两代发号策略（雪花 1+41+10+12 / 号段），端口 18140，全程离线零外部服务</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.eco.bom.version>1.0.0-SNAPSHOT</aifei.eco.bom.version>
        <undertow.version>2.2.39.Final</undertow.version>
    </properties>

    <!-- 根 pom 兼作 BOM：子模块不设 parent，通过 import 统一版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.gollyhu</groupId>
                <artifactId>aifei-eco-bom</artifactId>
                <version>${aifei.eco.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- demo 是应用工程：框架内核用 compile（aifei-id 以 provided 声明 aifei，消费方必须自带） -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-enjoy</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-json</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-undertow</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- 被演示的库本体：IdKit / IdGenerator / IdException + aifei.IdPlugin，零第三方 -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-id</artifactId>
        </dependency>

        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>${undertow.version}</version>
        </dependency>

        <!-- 零日志绑定：demo 自带极简 ConsoleLogFactory（System.out），不引 slf4j / log4j -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!-- 保留方法参数名，否则 Service 方法参数名退化为 arg0，反射注入取不到值 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
