<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-i18n-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-i18n-demo</name>
    <description>示例工程（不发布）：真实 Enjoy 渲染演示 aifei-i18n 三条指令与语言包下发，端口 18170，全程离线</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.version>1.1.2</aifei.version>
        <aifei-i18n.version>1.0.0-SNAPSHOT</aifei-i18n.version>
        <undertow.version>2.2.39.Final</undertow.version>
    </properties>

    <dependencies>
        <!-- demo 是应用工程：框架内核以 compile 自带（含 Enjoy） -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-all</artifactId>
            <version>${aifei.version}</version>
        </dependency>

        <!-- 被演示的库本体：需先在 aifei-i18n/ 执行 mvn -DskipTests install -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-i18n</artifactId>
            <version>${aifei-i18n.version}</version>
        </dependency>

        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>${undertow.version}</version>
        </dependency>

        <!-- H2 内存库：i18n_message 初始译文迁移 + 热重载落点；重启复位 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>

        <!-- 零日志绑定：demo 自带极简 ConsoleLogFactory（System.out） -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!-- 保留方法参数名，否则 Service 方法参数名退化为 arg0，反射注入取不到值 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
