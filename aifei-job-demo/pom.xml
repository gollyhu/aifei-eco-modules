<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-job-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-job-demo</name>
    <description>示例工程：验证 aifei-job 的装配 / 触发 / 异常隔离 / 停机收敛（不随模块发布）</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.eco.bom.version>1.0.0-SNAPSHOT</aifei.eco.bom.version>
        <undertow.version>2.2.39.Final</undertow.version>
        <log4j.version>2.26.0</log4j.version>
    </properties>

    <!-- 根 pom 兼作 BOM：子模块不设 parent，通过 import 统一版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.gollyhu</groupId>
                <artifactId>aifei-eco-bom</artifactId>
                <version>${aifei.eco.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 框架内核：aifei-job 对它是 provided，不传递，必须由应用自带 -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-enjoy</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-json</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-undertow</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-log</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-db</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- 被演示的模块：定时任务（Quartz 与 slf4j-api 随之传递） -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-job</artifactId>
        </dependency>

        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>${undertow.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!-- 保留方法参数名，否则参数名退化为 arg0，反射注入取不到值 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
