<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-i18n</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-i18n</name>
    <description>面向 aifei 应用的国际化 SDK：开放来源 + 唯一回退链 + Locale 贯通 + 整包导出 + 格式化薄封装（零第三方 compile 依赖）。</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.version>1.1.2</aifei.version>
        <aifei-cache.version>1.1.0</aifei-cache.version>
        <junit.version>4.13.2</junit.version>
        <h2.version>2.2.224</h2.version>
        <jedis.version>8.0.1</jedis.version>
        <fury.version>0.10.3</fury.version>
        <!-- 真实来源集成测试开关，默认关闭：-Ddb.integration=true / -Dkv.integration=true -->
        <db.integration>false</db.integration>
        <db.jdbcUrl>jdbc:h2:mem:i18n_it;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</db.jdbcUrl>
        <kv.integration>false</kv.integration>
        <redis.uri>redis://127.0.0.1:6379/0</redis.uri>
    </properties>

    <dependencies>
        <!-- 框架内核：provided，消费方自带，不向下游传递 -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-all</artifactId>
            <version>${aifei.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- kv 来源的可选依赖：optional，不向下游传递，消费方须显式引入 -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-cache</artifactId>
            <version>${aifei-cache.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 集成测试专用（test scope，非 compile）：db 来源用 H2 内存库，kv 来源用真实 Redis -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.fury</groupId>
            <artifactId>fury-core</artifactId>
            <version>${fury.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- 门禁依赖模块根相对路径 src/main/java，工作目录固定为模块根 -->
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <trimStackTrace>false</trimStackTrace>
                    <systemPropertyVariables>
                        <db.integration>${db.integration}</db.integration>
                        <db.jdbcUrl>${db.jdbcUrl}</db.jdbcUrl>
                        <kv.integration>${kv.integration}</kv.integration>
                        <redis.uri>${redis.uri}</redis.uri>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
