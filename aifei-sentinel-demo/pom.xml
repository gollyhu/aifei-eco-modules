<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-sentinel-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-sentinel-demo</name>
    <description>自写 HIO 的最小接入示例，验证 aifei-sentinel 对接</description>

    <properties>
        <aifei.eco.bom.version>1.0.0-SNAPSHOT</aifei.eco.bom.version>
        <undertow.version>2.2.39.Final</undertow.version>
        <log4j.version>2.26.0</log4j.version>
    </properties>

    <!-- 根 pom 兼作 BOM：子模块不设 parent，通过 import 统一版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.gollyhu</groupId>
                <artifactId>aifei-eco-bom</artifactId>
                <version>${aifei.eco.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-enjoy</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-json</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-undertow</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-log</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-db</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-sentinel</artifactId>
        </dependency>

        <!-- Dashboard 模式需要：连接官方 Sentinel 控制台（本地模式不配 dashboard.server 则不受影响） -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-transport-simple-http</artifactId>
        </dependency>

        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>${undertow.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                    <!-- 保留方法参数名，否则 action 参数名退化为 arg0，反射注入将取不到值 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
