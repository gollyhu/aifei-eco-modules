<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-tools</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-tools</name>
    <description>极简工具集：离线 IP 归属地（ip2region 可选）、验证码（可选 aifei-cache）、二维码（ZXing 可选）、通用脱敏；根包零公共类型</description>
    <url>https://github.com/gollyhu/aifei-tools</url>

    <!-- 以下为发布到 Maven Central 的必需元数据，清单见 https://central.sonatype.org/publish/requirements/
         licenses 元素与仓库根 LICENSE 的 Apache License 2.0 保持一致。 -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>gollyhu</name>
        <url>https://github.com/gollyhu</url>
    </organization>

    <developers>
        <developer>
            <id>gollyhu</id>
            <name>糊搞</name>
            <email>3722711@qq.com</email>
            <url>https://github.com/gollyhu</url>
            <roles>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/gollyhu/aifei-tools.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/gollyhu/aifei-tools.git</developerConnection>
        <url>https://github.com/gollyhu/aifei-tools</url>
    </scm>

    <!-- 只声明 snapshot 仓库：release 由 central-publishing-maven-plugin 以 bundle 方式提交，不经
         maven-deploy-plugin，因此不声明 release 仓库 —— 声明它只会把不带 profile 的 mvn deploy
         引向 Portal 的 releases 路径，而该路径不接受直接上传。
         snapshot 仓库 id 需在 settings.xml 中有同名 server（发布 profile 用的是 aifei）。 -->
    <distributionManagement>
        <snapshotRepository>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>

        <aifei.version>1.1.2</aifei.version>
        <ip2region.version>3.3.7</ip2region.version>
        <zxing.version>3.5.3</zxing.version>
        <junit.version>4.13.2</junit.version>
    </properties>

    <dependencies>
        <!-- 生态统一底座：provided，消费方自带，本模块源码零引用、不向下游传递 -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-all</artifactId>
            <version>${aifei.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- IP 归属地内核：optional 阻断传递，仅 ipdb/internal 引用；缺失时首次调用抛可读 IpException -->
        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
            <version>${ip2region.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- captcha 集群共享存储内核：optional 阻断传递，仅 captcha/internal 经反射探测；缺失时抛可读 CaptchaException -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-cache</artifactId>
            <version>1.1.0</version>
            <optional>true</optional>
        </dependency>

        <!-- 二维码内核：optional 阻断传递，零传递依赖，仅 qr/internal 引用；缺失时抛可读 QrException；不引 javase -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- 架构门禁依赖模块根相对路径 src/main/java，工作目录固定为模块根 -->
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <show>public</show>
                    <excludePackageNames>cn.hg.aifei.tools.ipdb.internal.*:cn.hg.aifei.tools.captcha.internal.*:cn.hg.aifei.tools.qr.internal.*:cn.hg.aifei.tools.mask.internal.*:cn.hg.aifei.tools.kdf.internal.*</excludePackageNames>
                    <doclint>none</doclint>
                    <detectJavaApiLink>false</detectJavaApiLink>
                    <detectOfflineLinks>false</detectOfflineLinks>
                    <failOnError>false</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -Pcentral-release clean deploy -->
        <profile>
            <id>central-release</id>
            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>aifei</publishingServerId>
                            <deploymentName>aifei-tools-${project.version}</deploymentName>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>
</project>
