<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-excel-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>aifei-excel-demo</name>
    <description>示例工程（不发布）：验证 aifei-excel 上传解析、一次性导出与流式导出，端口 18150，全程离线</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.version>1.1.2</aifei.version>
        <aifei-excel.version>1.0.0</aifei-excel.version>
        <easyexcel.version>3.3.2</easyexcel.version>
        <undertow.version>2.2.39.Final</undertow.version>
    </properties>

    <dependencies>
        <!-- demo 是应用工程：框架内核以 compile 自带（库模块 aifei-all 为 provided） -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-all</artifactId>
            <version>${aifei.version}</version>
        </dependency>

        <!-- 被演示的库本体：需先在 aifei-excel/ 执行 mvn -DskipTests clean install -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-excel</artifactId>
            <version>${aifei-excel.version}</version>
        </dependency>

        <!-- 库模块以 optional 声明唯一内核，消费方（本 demo）必须自带，验证 optional 口径 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>

        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>${undertow.version}</version>
        </dependency>

        <!-- 零日志绑定：demo 自带极简 ConsoleLogFactory（System.out） -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!-- 保留方法参数名，否则 Service 方法参数名退化为 arg0，反射注入取不到值 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
