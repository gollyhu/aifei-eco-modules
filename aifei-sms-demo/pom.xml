<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-sms-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aifei-sms-demo</name>
    <description>示例工程（不发布）：验证 aifei-sms 的模板化发送、多通道、配置/依赖错误态、回执接收与空态，端口 18180，全程离线 mock</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.eco.bom.version>1.0.0-SNAPSHOT</aifei.eco.bom.version>
        <undertow.version>2.2.39.Final</undertow.version>
    </properties>

    <!-- 根 pom 兼作 BOM：子模块不设 parent，通过 import 统一版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.gollyhu</groupId>
                <artifactId>aifei-eco-bom</artifactId>
                <version>${aifei.eco.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- demo 是应用工程：框架内核以 compile 自带（库模块 aifei 为 provided） -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-enjoy</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-json</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-undertow</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- 被演示的库本体：需先在 aifei-sms/ 执行 mvn -q -DskipTests clean install -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-sms</artifactId>
        </dependency>

        <!-- 库模块以 optional 声明唯一内核；demo 以 compile 自带，验证 optional 口径 -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>${undertow.version}</version>
        </dependency>
        <!-- 零日志绑定：demo 自带 ConsoleLogFactory（System.out） -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
