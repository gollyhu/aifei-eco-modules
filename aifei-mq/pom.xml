<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-mq</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>aifei-mq</name>
    <description>Pluggable messaging capability for aifei applications.</description>

    <!--
        聚合工程：core 为契约与装配层，memory 为进程内后端（零第三方运行依赖）；
        其余后端按批次陆续迁入独立子模块，旧 src/ 下的实现暂不参与构建。
    -->
    <modules>
        <module>aifei-mq-core</module>
        <module>aifei-mq-memory</module>
        <module>aifei-mq-mqtt</module>
        <module>aifei-mq-mqtt5</module>
        <module>aifei-mq-rocketmq</module>
        <module>aifei-mq-rabbitmq</module>
        <module>aifei-mq-kafka</module>
        <module>aifei-mq-redisstream</module>
    </modules>
</project>
