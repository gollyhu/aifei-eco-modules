<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-mq-mqtt5</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>aifei-mq-mqtt5</name>
    <description>MQTT v5.0 backend of aifei-mq (experimental: not published, semantics not guaranteed).</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>4.13.2</junit.version>
        <paho.version>1.2.5</paho.version>
        <!-- 实验性后端：只随聚合构建验证，不进中央仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- 契约与装配层：唯一自有运行依赖 -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-mq-core</artifactId>
            <version>1.0.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- core 的契约基类（MessageBusContractTest）随 test-jar 复用 -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-mq-core</artifactId>
            <version>1.0.0</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Eclipse Paho v5 客户端：本后端的第三方运行依赖，随本模块向下游传递 -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.mqttv5.client</artifactId>
            <version>${paho.version}</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 契约用例默认跳过：真实 broker 由 CI / 本地按需开启 -->
                        <mqtt5.integration>false</mqtt5.integration>
                        <mqtt5.broker-url>tcp://127.0.0.1:1883</mqtt5.broker-url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
