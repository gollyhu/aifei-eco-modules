<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gollyhu</groupId>
    <artifactId>aifei-lock</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>aifei-lock</name>
    <description>分布式锁的 aifei 接入 SDK：基于共享缓存的原子加锁、CAS 释放与 CAS 续期</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aifei.version>1.1.2</aifei.version>
        <aifei-cache.version>1.1.0</aifei-cache.version>
        <junit.version>4.13.2</junit.version>
        <!-- 仅集成测试：与 aifei-cache 保持同一版本 -->
        <jedis.version>8.0.1</jedis.version>
        <fury-core.version>0.10.3</fury-core.version>
        <!-- Redis 集成用例开关：默认关闭；开启后连不上必须失败 -->
        <redis.integration>false</redis.integration>
        <redis.uri>redis://127.0.0.1:6379/0</redis.uri>
        <!-- 计时用例开关：默认关闭，不进默认 CI -->
        <lock.timing>false</lock.timing>
    </properties>

    <dependencies>
        <!-- 内核：provided，消费方自带（日志门面 cn.aifei.log 随它提供） -->
        <dependency>
            <groupId>cn.aifei</groupId>
            <artifactId>aifei-all</artifactId>
            <version>${aifei.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            共享存储能力来源：optional 阻断传递，消费方必须显式引入 >= 1.1.0，
            否则 cache.CacheLockStore 在类加载期即 NoClassDefFoundError（早于启动校验）。
        -->
        <dependency>
            <groupId>io.github.gollyhu</groupId>
            <artifactId>aifei-cache</artifactId>
            <version>${aifei-cache.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            仅 Redis 集成用例需要：aifei-cache 的 jedis / fury-core 均为 optional、不传递，
            故测试期自行声明。test scope 不进入主 classpath，也不向下游传递。
        -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.fury</groupId>
            <artifactId>fury-core</artifactId>
            <version>${fury-core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <redis.integration>${redis.integration}</redis.integration>
                        <redis.uri>${redis.uri}</redis.uri>
                        <lock.timing>${lock.timing}</lock.timing>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <source>1.8</source>
                    <encoding>UTF-8</encoding>
                    <show>public</show>
                    <!-- internal / cache / aifei 均属非承诺 API，不进对外 Javadoc -->
                    <excludePackageNames>cn.hg.aifei.lock.internal,cn.hg.aifei.lock.cache,cn.hg.aifei.lock.aifei</excludePackageNames>
                    <doclint>none</doclint>
                    <detectJavaApiLink>false</detectJavaApiLink>
                    <detectOfflineLinks>false</detectOfflineLinks>
                    <failOnError>false</failOnError>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
